(defwidget bar [show_mpris show_tray active_tag layout]
  (centerbox :class "bar"
    (box :class "left" :halign "start" :hexpand false :space-evenly false
      (power-widget)
      (separator)
      (workspaces-widget :active_tag active_tag)
      (separator)
      (layout-widget :layout layout)
      (separator)
      (updates-widget)
      (separator)
      (docker-widget)
      (box :visible show_mpris :halign "start" :hexpand false :space-evenly false
        (separator)
        (audio-meter-widget)
        (media-player-widget)))
    (box :class "center" :halign "center"
      (clock-widget))
    (box :class "right" :halign "end" :space-evenly false
      (bluetooth-widget)
      (separator)
      (audio-output-widget)
      (separator)
      (battery-widget)
      (power-profile-widget)
      (separator)
      (network-widget)
      (network-speed-widget)
      (separator)
      (volume-widget)
      (separator)
      (memory-widget)
      (separator)
      (cpu-widget)
      (gpu-widget)
      (separator)
      (services-widget)
      (separator)
      (tray-widget :visible show_tray))))
