(defpoll clock :interval "1s" `date '+%H:%M • %d/%m/%Y'`)
(defpoll updates :interval "30m" `printf '󰏖 %s/%s' "$(checkupdates 2>/dev/null | grep -c .)" "$(yay -Qua 2>/dev/null | grep -c .)"`)
(defpoll docker :interval "5s" `systemctl is-active --quiet docker && printf '󰡨 %s/%s' "$(docker ps -q | wc -l)" "$(docker ps -aq | wc -l)" || printf '󰡨 nr'`)
(defpoll mpris :interval "2s" `playerctl -a metadata --format '{{status}}\t{{artist}} - {{title}}' 2>/dev/null | awk -F '\t' '$1 == "Playing" {print " " $2; exit}' | cut -c1-35`)
(defpoll bluetooth :interval "5s" `bluetoothctl show 2>/dev/null | grep -q 'Powered: yes' && printf 'bt %s' "$(bluetoothctl devices Connected 2>/dev/null | wc -l)" || printf 'bt off'`)
(defpoll audio_output :interval "2s" `bash ~/.config/eww/scripts/audio-output.sh`)
(defpoll battery :interval "30s" `upower -i "$(upower -e | grep BAT | head -1)" 2>/dev/null | awk -F: '/state:/ {state=$2} /percentage:/ {percent=$2} END {gsub(/^ +| +$/, "", state); gsub(/^ +| +$/, "", percent); print (state == "charging" ? "󰂄 " : "󱟢 ") (percent == "" ? "nb" : percent)}'`)
(defpoll power_profile :interval "5s" `powerprofilesctl get 2>/dev/null | sed 's/performance/perf/; s/balanced/bal/; s/power-saver/eco/'`)
(defpoll network :interval "3s" `wifi=$(nmcli -t -f ACTIVE,SSID dev wifi 2>/dev/null | awk -F: '$1 == "yes" {print "󰖩 " $2; exit}'); if [ -n "$wifi" ]; then printf '%s' "$wifi"; elif ethernet=$(nmcli -t -f DEVICE,TYPE,STATE dev 2>/dev/null | awk -F: '$2 == "ethernet" && $3 == "connected" {print $1; exit}'); [ -n "$ethernet" ]; then printf '󰈀 %s' "$ethernet"; else printf '󰌙 off'; fi`)
(defpoll network_speed :interval "1s" `iface=$(nmcli -t -f DEVICE,TYPE,STATE dev 2>/dev/null | awk -F: '$3 == "connected" {print $1; exit}'); if [ -n "$iface" ] && [ -r "/sys/class/net/$iface/statistics/rx_bytes" ]; then rx_before=$(cat "/sys/class/net/$iface/statistics/rx_bytes"); tx_before=$(cat "/sys/class/net/$iface/statistics/tx_bytes"); sleep 1; rx_after=$(cat "/sys/class/net/$iface/statistics/rx_bytes"); tx_after=$(cat "/sys/class/net/$iface/statistics/tx_bytes"); rx_rate=$((rx_after - rx_before)); tx_rate=$((tx_after - tx_before)); [ "$rx_rate" -lt 0 ] && rx_rate=0; [ "$tx_rate" -lt 0 ] && tx_rate=0; awk -v down="$rx_rate" -v up="$tx_rate" 'function format_speed(value, formatted) {if (value >= 1048576) formatted=sprintf("%.1fM", value / 1048576); else if (value >= 1024) formatted=sprintf("%.1fK", value / 1024); else formatted=sprintf("%.0fB", value); return sprintf("%4s", formatted)} BEGIN {printf "↑ %s ↓ %s", format_speed(up), format_speed(down)}'; else printf '↑   0B ↓   0B'; fi`)
(defpoll volume :interval "2s" `wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk '{printf "vol %d%%%s", $2 * 100, ($3 == "[MUTED]" ? " muted" : "")}'`)
(defpoll memory :interval "2s" `free | awk '/Mem:/ {printf " %02d%%", $3 / $2 * 100}'`)
(defpoll cpu :interval "2s" `top -bn1 | awk '/Cpu[(]s[)]/ {printf " %02d%%", 100 - $8}'`)
(defpoll gpu_state :interval "2s" `bash -c 'if output=$(nvidia-smi --query-gpu=pstate,utilization.gpu,power.draw --format=csv,noheader,nounits 2>/dev/null); then awk -F, "{gsub(/ /, \\"\\", \\$1); printf \\"󰢮 %s %s%% %.0fW\\", \\$1, \\$2, \\$3}" <<< "$output"; fi'`)
(defpoll services :interval "30s" `printf ' %s' "$(systemctl --user list-units --type=service --state=running --no-legend | grep -c .)"`)
(deflisten active_tag_dp4 `sh -c 'mmsg get tags DP-4; mmsg watch tags DP-4' | jq -r --unbuffered '.active_tags[0] // 1'`)
(deflisten active_tag_dp5 `sh -c 'mmsg get tags DP-5; mmsg watch tags DP-5' | jq -r --unbuffered '.active_tags[0] // 1'`)
(deflisten active_tag_dp6 `sh -c 'mmsg get tags DP-6; mmsg watch tags DP-6' | jq -r --unbuffered '.active_tags[0] // 1'`)
(deflisten active_tag_edp1 `sh -c 'mmsg get tags eDP-1; mmsg watch tags eDP-1' | jq -r --unbuffered '.active_tags[0] // 1'`)
(deflisten active_tag_hdmi1 `sh -c 'mmsg get tags HDMI-A-1; mmsg watch tags HDMI-A-1' | jq -r --unbuffered '.active_tags[0] // 1'`)
(deflisten layout_dp4 `sh -c 'mmsg get monitor DP-4; mmsg watch monitor DP-4' | jq -r --unbuffered '.layout_symbol // "?"'`)
(deflisten layout_dp5 `sh -c 'mmsg get monitor DP-5; mmsg watch monitor DP-5' | jq -r --unbuffered '.layout_symbol // "?"'`)
(deflisten layout_dp6 `sh -c 'mmsg get monitor DP-6; mmsg watch monitor DP-6' | jq -r --unbuffered '.layout_symbol // "?"'`)
(deflisten layout_edp1 `sh -c 'mmsg get monitor eDP-1; mmsg watch monitor eDP-1' | jq -r --unbuffered '.layout_symbol // "?"'`)
(deflisten layout_hdmi1 `sh -c 'mmsg get monitor HDMI-A-1; mmsg watch monitor HDMI-A-1' | jq -r --unbuffered '.layout_symbol // "?"'`)

(defwidget item [text command ?right_command]
  (button :class "item" :onclick "${command}" :onrightclick "${right_command}"
    (label :text text)))

(defwidget workspace [number active_tag]
  (button :class {active_tag == number ? "workspace active" : "workspace"} :onclick "mmsg dispatch toggletag,${number}"
    (label :text number)))

(defwidget bar [show_mpris show_tray active_tag layout]
  (centerbox :class "bar"
    (box :class "left" :halign "start" :hexpand false :space-evenly false
      (item :text "⏻" :command "setsid -f wleave --buttons-per-row 1/1 -x --button-aspect-ratio 1")
      (label :class "separator" :text "|")
      (box :class "workspaces" :space-evenly false
        (workspace :number "1" :active_tag active_tag) (workspace :number "2" :active_tag active_tag)
        (workspace :number "3" :active_tag active_tag) (workspace :number "4" :active_tag active_tag))
      (label :class "separator" :text "|")
      (item :text layout :command "mmsg dispatch switch_layout")
      (label :class "separator" :text "|")
      (item :text updates :command "setsid -f ghostty -e yay")
      (label :class "separator" :text "|")
      (item :text docker
        :command "systemctl is-active --quiet docker && (pkexec systemctl stop docker.service && pkexec systemctl stop docker.socket) || pkexec systemctl start docker")
      (box :visible show_mpris :halign "start" :hexpand false :space-evenly false
        (label :class "separator" :text "|")
        (item :text mpris :command "playerctl play-pause")))
    (box :class "center" :halign "center"
      (item :text clock :command "pkill -x waycal || setsid -f waycal"))
    (box :class "right" :halign "end" :space-evenly false
      (item :text bluetooth :command "setsid -f blueman-manager")
      (label :class "separator" :text "|")
      (item :text audio_output :command "setsid -f pavucontrol")
      (label :class "separator" :text "|")
      (item :text battery :command "notify-send Battery \"$(upower -i $(upower -e | grep BAT) | grep -E 'state|percentage|time to')\"")
      (item :text power_profile :command "powerprofilesctl set performance")
      (label :class "separator" :text "|")
      (item :text network :command "setsid -f ghostty -e nmtui")
      (label :text network_speed)
      (label :class "separator" :text "|")
      (item :text volume :command "setsid -f pavucontrol" :right_command "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle")
      (label :class "separator" :text "|")
      (item :text memory :command "setsid -f ghostty -e btop")
      (label :class "separator" :text "|")
      (item :text cpu :command "setsid -f ghostty -e btop")
      (box :visible {gpu_state != ""} :halign "start" :hexpand false :space-evenly false
        (label :class "separator" :text "|")
        (item :text gpu_state :command "setsid -f ghostty -e nvidia-smi"))
      (label :class "separator" :text "|")
      (item :text services :command "setsid -f ghostty -e systemctl --user")
      (label :class "separator" :text "|")
      (box :visible show_tray
        (systray :class "tray" :spacing 4 :icon-size 18)))))

(defwindow bar-dp4
  :geometry (geometry :x "0%" :y "0%" :width "100%" :height "28px" :anchor "top center")
  :stacking "fg"
  :exclusive true
  :focusable false
  (bar :show_mpris true :show_tray false :active_tag active_tag_dp4 :layout layout_dp4))

(defwindow bar-dp5
  :geometry (geometry :x "0%" :y "0%" :width "100%" :height "28px" :anchor "top center")
  :stacking "fg"
  :exclusive true
  :focusable false
  (bar :show_mpris true :show_tray true :active_tag active_tag_dp5 :layout layout_dp5))

(defwindow bar-dp6
  :geometry (geometry :x "0%" :y "0%" :width "100%" :height "28px" :anchor "top center")
  :stacking "fg"
  :exclusive true
  :focusable false
  (bar :show_mpris false :show_tray false :active_tag active_tag_dp6 :layout layout_dp6))

(defwindow bar-edp1
  :geometry (geometry :x "0%" :y "0%" :width "100%" :height "28px" :anchor "top center")
  :stacking "fg"
  :exclusive true
  :focusable false
  (bar :show_mpris true :show_tray false :active_tag active_tag_edp1 :layout layout_edp1))

(defwindow bar-hdmi1
  :geometry (geometry :x "0%" :y "0%" :width "100%" :height "28px" :anchor "top center")
  :stacking "fg"
  :exclusive true
  :focusable false
  (bar :show_mpris true :show_tray false :active_tag active_tag_hdmi1 :layout layout_hdmi1))
