{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "#E06C75",
          "style": "plain",
          "template": "root <#ffffff>in</> ",
          "type": "root"
        },
        {
          "foreground": "#55B9C4",
          "options": {
            "style": "folder"
          },
          "style": "plain",
          "template": "{{ .Path }} ",
          "type": "path"
        },
        {
          "foreground": "#C678DD",
          "options": {
            "fetch_status": true
          },
          "style": "plain",
          "template": "<#ffffff>on</> {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }} ",
          "type": "git"
        },
        {
          "foreground": "#98C379",
          "options": {
            "fetch_version": true
          },
          "style": "plain",
          "template": "<#ffffff>via</> \ue781 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ if .Full }}{{ .Full }}{{ else }}<#E06C75>nover</>{{ end }} ",
          "type": "node"
        },
        {
          "foreground": "#98C379",
          "options": {
            "name": "typescript",
            "extensions": ["*.ts", "*.tsx"],
            "project_files": ["tsconfig.json"],
            "tools": [
              {
                "name": "tsc",
                "executable": "tsc",
                "args": ["--version"],
                "regex": "Version (?P<version>\\d+\\.\\d+\\.\\d+(?:[-+][\\w.]+)?)"
              }
            ]
          },
          "style": "plain",
          "template": "/  {{ if .Full }}{{ .Full }}{{ else }}<#E06C75>nover</>{{ end }} ",
          "type": "language"
        },
        {
          "foreground": "#98C379",
          "style": "plain",
          "template": "{{ if env \"POSH_TURBO_VERSION\" }}/  {{ env \"POSH_TURBO_VERSION\" }} {{ end }}",
          "type": "text"
        },
        {
          "foreground": "#98C379",
          "style": "plain",
          "options": {
            "display_mode": "files",
            "extensions": ["yarn.lock"]
          },
          "template": "/  {{ if .Full }}{{ .Full }}{{ else }}<#E06C75>nover</>{{ end }} ",
          "type": "yarn"
        },
        {
          "foreground": "#98C379",
          "style": "plain",
          "options": {
            "display_mode": "files",
            "extensions": ["package-lock.json"]
          },
          "template": "/  {{ if .Full }}{{ .Full }}{{ else }}<#E06C75>nover</>{{ end }} ",
          "type": "npm"
        },
        {
          "foreground": "#98C379",
          "style": "plain",
          "options": {
            "display_mode": "files",
            "extensions": ["pnpm-lock.yaml"]
          },
          "template": "/  {{ if .Full }}{{ .Full }}{{ else }}<#E06C75>nover</>{{ end }}",
          "type": "pnpm"
        },
        {
          "foreground": "#C94A16",
          "style": "plain",
          "template": "x ",
          "type": "status"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#63F08C",
          "style": "plain",
          "template": "\u279c ",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "version": 4
}
