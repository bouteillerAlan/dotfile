#!/usr/bin/env bash

source "$(dirname "${BASH_SOURCE[0]}")/config"

selection=$(mmsg get all-clients | jq -r '.clients[] | "\(.id)\t[\(.tags | join(","))] \(.appid): \(.title)"' |
    BEMENU_BACKEND=wayland bemenu --single-instance --ignorecase --list 8 --prompt win) || exit 0
client_id=${selection%%$'\t'*}
active_tag=$(mmsg get all-monitors | jq -r '.monitors[] | select(.active).active_tags[0]') || exit 0
mmsg dispatch "tagsilent,$active_tag" "client,$client_id" &&
    mmsg dispatch "focusid,$client_id"
